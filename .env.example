# Copy to .env.local (keep it UTF-8) and fill in from
# Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_... or eyJ...

# Server-only: needed for the optional two-manager faceoff API. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
